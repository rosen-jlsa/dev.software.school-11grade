#!/bin/bash

# ============================================================================
# Docker Nginx Setup Script
# ============================================================================
# This script automates the creation and deployment of a Dockerized Nginx
# web server. It creates necessary files, builds a Docker image, and runs
# a container that serves a simple HTML page.
# ============================================================================

# Define Docker image name and tag
IMAGE_NAME="my-nginx-app"
IMAGE_TAG="1.0"

# ----------------------------------------------------------------------------
# STEP 1: Create HTML directory and index.html file
# ----------------------------------------------------------------------------
# Create the 'html' directory if it doesn't exist (-p prevents error if exists)
mkdir -p html

# Check if index.html doesn't exist, then create it with a simple HTML page
if [ ! -f html/index.html ]; then
    # Create a simple HTML page with inline CSS
    echo '<!DOCTYPE html>
<html>
<head>
    <title>Hello Docker!</title>
    <style>
        body { 
            font-family: sans-serif; 
            text-align: center; 
            margin-top: 50px; 
        }
    </style>
</head>
<body>
    <h1>Hello from your Dockerized Nginx!</h1>
    <p>This is a simple web page served by Nginx inside a Docker container.</p>
</body>
</html>' > html/index.html
    echo "Created html/index.html"
fi

# ----------------------------------------------------------------------------
# STEP 2: Create Nginx configuration file
# ----------------------------------------------------------------------------
# Check if nginx.conf doesn't exist, then create it
if [ ! -f "nginx.conf" ]; then
    # Create Nginx server configuration
    # - listen 80: Nginx listens on port 80 inside the container
    # - server_name localhost: Server name for this virtual host
    # - root /usr/share/nginx/html: Directory where HTML files are served from
    # - index: Default files to serve when accessing a directory
    # - try_files: Fallback behavior for file not found (returns 404)
    echo 'server {
    listen 80;
    server_name localhost;
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ =404;
    }
}' > nginx.conf
    echo "Created nginx.conf"
fi

# ----------------------------------------------------------------------------
# STEP 3: Create Dockerfile
# ----------------------------------------------------------------------------
# Check if Dockerfile doesn't exist, then create it
if [ ! -f "Dockerfile" ]; then
    # Create Dockerfile with the following instructions:
    # FROM: Base image (official Nginx image)
    # RUN: Remove default Nginx config
    # COPY: Copy our custom nginx.conf to container
    # COPY: Copy HTML files to container's web directory
    # EXPOSE: Document that container listens on port 80
    # CMD: Command to run when container starts (Nginx in foreground mode)
    echo -e "FROM nginx:latest
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/
COPY html/ /usr/share/nginx/html/
EXPOSE 80
CMD [\"nginx\", \"-g\", \"daemon off;\"]" > Dockerfile
    echo "Created Dockerfile"
fi

# ============================================================================
# STEP 4: Build Docker Image
# ============================================================================
echo "Building Docker image: $IMAGE_NAME:$IMAGE_TAG"
docker build -t $IMAGE_NAME:$IMAGE_TAG .

# Check if the build was successful ($? contains exit status of last command)
# -eq 0 means success (exit code 0)
if [ $? -eq 0 ]; then
    echo "✓ Docker image built successfully!"
    echo "Running Docker container..."
    
    # ------------------------------------------------------------------------
    # STEP 5: Stop and remove any existing container with the same name
    # ------------------------------------------------------------------------
    # Stop the container if it exists (redirect output to /dev/null to suppress errors)
    # 2>&1 redirects stderr to stdout, then both go to /dev/null
    docker stop my-nginx-container > /dev/null 2>&1
    docker rm my-nginx-container > /dev/null 2>&1
    
    # ------------------------------------------------------------------------
    # STEP 6: Run the new Docker container
    # ------------------------------------------------------------------------
    # docker run options:
    # -d: Run container in detached mode (background)
    # -p 8080:80: Port mapping (host:container) - map host port 8080 to container port 80
    # --name: Assign a name to the container
    # $IMAGE_NAME:$IMAGE_TAG: Image to run
    docker run -d -p 8080:80 --name my-nginx-container $IMAGE_NAME:$IMAGE_TAG
    
    # Check if container started successfully
    if [ $? -eq 0 ]; then
        echo ""
        echo "✓ Container 'my-nginx-container' is running successfully!"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "🌐 Access your web page at: http://localhost:8080"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "Useful commands:"
        echo "  • Stop container:    docker stop my-nginx-container"
        echo "  • Remove container:  docker rm my-nginx-container"
        echo "  • View logs:         docker logs my-nginx-container"
        echo "  • Remove image:      docker rmi $IMAGE_NAME:$IMAGE_TAG"
        echo ""
    else
        echo "✗ Failed to run Docker container."
        exit 1
    fi
else
    echo "✗ Failed to build Docker image."
    exit 1
fi
